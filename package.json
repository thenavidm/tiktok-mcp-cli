{
  "name": "@thenavidm/tiktok-mcp-cli",
  "version": "2.0.0",
  "description": "TikTok MCP server and CLI for Claude Code and AI agents. 14 tools for your profile, video stats, top posts, publishing videos and photo carousels, drafts and post status.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tiktok-mcp": "dist/index.js",
    "tiktok-cli": "dist/index.js",
    "tiktok-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.10",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://github.com/thenavidm/tiktok-mcp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/tiktok-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/tiktok-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tiktok",
    "tiktok-api",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools",
    "mcp-cli",
    "cli",
    "tiktok-content-posting",
    "tiktok-display-api",
    "social-media",
    "video",
    "slipway"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
